[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3

[libraries]
linux.x86_64 = "res://addons/godot_scratch_card/bin/libgodot_scratch_card.so"
linux.x86_64.debug = "res://addons/godot_scratch_card/bin/libgodot_scratch_card.so"
windows.x86_64 = "res://addons/godot_scratch_card/bin/godot_scratch_card.dll"
windows.x86_64.debug = "res://addons/godot_scratch_card/bin/godot_scratch_card.dll"
macos.x86_64 = "res://addons/godot_scratch_card/bin/libgodot_scratch_card.dylib"
macos.arm64 = "res://addons/godot_scratch_card/bin/libgodot_scratch_card.dylib"



